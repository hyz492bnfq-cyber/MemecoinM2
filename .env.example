# Required: shared dashboard access code
DASHBOARD_ACCESS_CODE=replace_with_a_long_random_code

# Required: generate once and keep unchanged between restarts
# Changing this secret invalidates all existing browser sessions.
DASHBOARD_SESSION_SECRET=replace_with_at_least_32_random_bytes

# Public HTTPS URL of your dashboard, without trailing slash
DASHBOARD_URL=https://your-domain.example

# Telegram bot token (optional during dashboard-only testing)
BOT_TOKEN=

# Optional
PORT=3000
NODE_ENV=production
